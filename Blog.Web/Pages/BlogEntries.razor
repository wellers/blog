@page "/blogentries"
@inject IBlogEntryRepository BlogEntryRepository

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3">Blog Entries</h1>
  <input @bind="SearchTerm" @bind:event="oninput" placeholder="Search titles" class="form-control search-input" />
</div>

@if (pagedEntries is null)
{
    <p><em>Loading...</em></p>
}
else if (!pagedEntries.Any())
{
    <p>No blog entries found.</p>
}
else
{
    <div class="row">
        @foreach (var e in pagedEntries)
        {
            <div class="col-12">
                <div class="card card-entry">
                    <div class="card-body">
                        <h5 class="card-title">@e.Title</h5>
                        <h6 class="card-subtitle mb-2 text-muted">@e.PostedDate.ToString("yyyy-MM-dd")</h6>
                        <p class="card-text entry-excerpt">@(new MarkupString((e.Entry ?? string.Empty).Length > 300 ? (e.Entry ?? string.Empty).Substring(0, 300) + "..." : (e.Entry ?? string.Empty)))</p>
                        @if (e.Tags != null && e.Tags.Any())
                        {
                            <div>
                                @foreach (var t in e.Tags)
                                {
                                    <span class="badge bg-light text-dark tag-badge">@t.Name</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <nav class="mt-3">
        <ul class="pagination pagination-center">
            <li class="page-item @(currentPage==1?"disabled":"")"><button class="page-link" @onclick="Prev">Previous</button></li>
            @foreach (var p in pages)
            {
                <li class="page-item @(p==currentPage?"active":"")"><button class="page-link" @onclick="() => GoToPage(p)">@p</button></li>
            }
            <li class="page-item @(currentPage==totalPages?"disabled":"")"><button class="page-link" @onclick="Next">Next</button></li>
        </ul>
    </nav>
}

@code {
    private IList<IBlogEntryModel>? allEntries;
    private IList<IBlogEntryModel>? pagedEntries;
    private string? searchTerm;
    private int pageSize = 5;
    private int currentPage = 1;
    private int totalPages = 1;
    private List<int> pages = new();

    protected override void OnInitialized()
    {
        // load a reasonable number of recent entries and paginate client-side
        allEntries = BlogEntryRepository.GetTopMostRecentBlogEntries(200);
        ApplyFilterAndPaging();
    }

    private void ApplyFilterAndPaging()
    {
        var filtered = string.IsNullOrWhiteSpace(searchTerm)
            ? allEntries ?? new List<IBlogEntryModel>()
            : (allEntries ?? new List<IBlogEntryModel>()).Where(e => (e.Title ?? string.Empty).Contains(searchTerm!, StringComparison.OrdinalIgnoreCase)).ToList();

        totalPages = Math.Max(1, (int)Math.Ceiling((double)filtered.Count() / pageSize));
        if (currentPage > totalPages) currentPage = totalPages;

        pagedEntries = filtered.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
        pages = Enumerable.Range(1, totalPages).ToList();
    }

    private void Prev()
    {
        if (currentPage > 1) currentPage--;
        ApplyFilterAndPaging();
    }

    private void Next()
    {
        if (currentPage < totalPages) currentPage++;
        ApplyFilterAndPaging();
    }

    private void GoToPage(int p)
    {
        if (p < 1 || p > totalPages) return;
        currentPage = p;
        ApplyFilterAndPaging();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        searchTerm = e?.Value?.ToString();
        currentPage = 1;
        ApplyFilterAndPaging();
    }

    // Bind searchTerm two-way and also call filter when changed
    private string? SearchTerm
    {
        get => searchTerm;
        set { searchTerm = value; currentPage = 1; ApplyFilterAndPaging(); }
    }
}
